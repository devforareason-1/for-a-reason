# Copy to .env.local. Every value is optional in development.

# Public origin, used for canonical URLs, Open Graph, the sitemap and structured data.
# Required in production. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Confirmed public contact channels. Anything left empty is simply not rendered.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Where validated enquiries are delivered, as a JSON POST (Zapier, Make, Formspree,
# your own endpoint...). Server-only. While unset, the form reports that enquiries
# are not connected and never shows a success state.
CONTACT_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <value>" with each delivery. Server-only.
CONTACT_WEBHOOK_SECRET=
